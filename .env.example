# Copy this file to .env and fill in YOUR OWN key. Never commit .env to git.

# Which provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave OPENAI_BASE_URL blank to use real OpenAI. Set it to point the same
# OPENAI_API_KEY/OPENAI_MODEL pair at any OpenAI-compatible endpoint instead
# — useful for free-tier providers when you don't want to pay:
#   OpenRouter : OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free (or any :free model)
#                OPENAI_API_KEY=<your OpenRouter key>
#   Groq       : OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                OPENAI_MODEL=llama-3.1-8b-instant
#                OPENAI_API_KEY=<your Groq key>
#   Ollama     : OPENAI_BASE_URL=http://localhost:11434/v1
#                OPENAI_MODEL=llama3.2
#                OPENAI_API_KEY=ollama   (any non-empty string, Ollama ignores it)
OPENAI_BASE_URL=
